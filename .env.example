# Portable core: only these three are required to run anywhere (Railway, VPS, local).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/freeagents_local
AUTH_SECRET=change-me-openssl-rand-base64-32
APP_URL=http://localhost:3000

# Optional: notify the CRM when a lead/registration happens. No-op when unset.
# CRM_WEBHOOK_URL=https://crm.example.com/api/leads/local
# CRM_WEBHOOK_SECRET=shared-secret
